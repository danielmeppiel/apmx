---
// The four promises of APMX. Rendered identically at the top of the page
// and in the close; each card links to the docs that show the engineering.
interface Props { labelledby?: string }
const { labelledby } = Astro.props;
const docs = (path: string) => `${import.meta.env.BASE_URL}docs/${path}`;
const items = [
  ['Traceability', 'Every delivered file is cryptographically bound to the factory that made it and the checks it passed.', docs('receipt/')],
  ['Portability', 'Same factory, skills and checks on your choice of harness and model.', docs('any-harness/')],
  ['Security', 'Agent, checks and signer run apart. The agent cannot sign or change its checks.', docs('accept-prs/#1-produce-in-ci')],
  ['Trust', 'Only factories you approved ship: signed provenance, intact files, your checks passed.', docs('accept-prs/#2-pin-what-you-accept')],
];
---
<div class="promises">
  <ol class="pains" aria-labelledby={labelledby}>
    {items.map(([title, line, href], i) => (
      <li><a href={href}><span class="pn" aria-hidden="true">{i + 1}</span><b>{title}</b><span>{line}</span></a></li>
    ))}
  </ol>
  <p class="unlock"><b>Merge on trusted evidence.</b></p>
</div>
