---
// The four promises of APMX. Rendered identically at the top of the page
// and in the close; each card links to the docs that show the engineering.
interface Props { labelledby?: string }
const { labelledby } = Astro.props;
const docs = (path: string) => `${import.meta.env.BASE_URL}docs/${path}`;
const items = [
  ['Trust', 'Only reviewed factory versions can merge. No PR can rewrite its own gate.', docs('accept-prs/#2-pin-what-you-accept')],
  ['Traceability', 'Every change names the exact factory and components that made it.', docs('receipt/')],
  ['Portability', 'Switch coding agent or model. The factory and its checks stay the same.', docs('any-harness/')],
  ['Security', 'The agent cannot sign its own work or change its checks.', docs('accept-prs/#1-produce-in-ci')],
];
---
<div class="promises">
  <ol class="pains" aria-labelledby={labelledby}>
    {items.map(([title, line, href], i) => (
      <li><a href={href}><span class="pn" aria-hidden="true">{i + 1}</span><b>{title}</b><span>{line}</span></a></li>
    ))}
  </ol>
  <p class="unlock">Together they unlock <b>automated merges</b>.</p>
</div>
