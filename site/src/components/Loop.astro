<svg viewBox="0 0 1200 430" role="img" aria-labelledby="f2t"><title id="f2t">The agent loop: checks reject an attempt, the agent retries within budget, then the output is handed on</title>
        <rect class="sheet" x="10" y="110" width="250" height="140" rx="6" stroke-width="2"/>
        <text class="tc" x="34" y="160">Agent Contract</text>
        <text class="tm" x="34" y="200">Budget: 3 tries</text>
        <path class="flow" d="M260 180H318" marker-end="url(#ag)"/>
        <rect class="loop" x="326" y="125" width="240" height="110" rx="12"/>
        <g transform="translate(376 180)"><path class="flow" d="M-18 0A18 18 0 0 1 18 0" marker-end="url(#ag)"/><path class="fb" d="M18 0A18 18 0 0 1 -18 0" marker-end="url(#ap)"/></g>
        <text class="t1" x="414" y="190">Agent</text>
        <path class="flow" d="M566 180H624" marker-end="url(#ag)"/>
        <path class="chip" d="M632 140H780L800 160V220H632Z"/>
        <text class="t2" x="656" y="188">Output</text>
        <path class="flow" d="M800 180H858" marker-end="url(#ag)"/>
        <rect class="node" x="866" y="86" width="324" height="188" rx="12"/>
        <text class="t3" x="890" y="122">Checks, attempt 2 of 3</text>
        <text class="t2" x="890" y="166"><tspan class="mono" font-size="19" fill="#56d364">[+]</tspan> Acceptance tests</text>
        <text class="t2" x="890" y="206"><tspan class="mono" font-size="19" fill="#56d364">[+]</tspan> Regression tests</text>
        <text class="t2" x="890" y="246"><tspan class="mono" font-size="19" fill="#56d364">[+]</tspan> Report written</text>
        <path class="fb" d="M980 274V330H446V243" marker-end="url(#ap)"/>
        <text x="500" y="368" font-size="20" font-weight="500" fill="#d2a8ff">Attempt 1 rejected: back to the agent</text>
        <path class="flow" d="M1140 274V392" marker-end="url(#ag)"/>
        <text class="t2" x="1124" y="420" text-anchor="end">Passed: handed on</text>
      </svg>
